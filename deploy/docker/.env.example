# AML Platform — docker compose settings. Copy to ".env" in the repository root (next to docker-compose.yml).
# NEVER commit the real .env. Generate the values with deploy/docker/generate-env.ps1 (Windows) or:
#   openssl rand -base64 32      (for each *_KEY)
# All data in a test environment must be synthetic; jurisdiction values remain "to be confirmed by compliance".

# Public address users open in the browser (used for CORS) and the host port of the web container.
PUBLIC_URL=http://<server-name-or-ip>:8080
WEB_PORT=8080

# Staging = test server (development login allowed, no FIU submission). Use Production only with an OIDC provider.
ASPNETCORE_ENVIRONMENT=Staging

# SQL Server (container). Password: at least 8 chars with upper, lower, digit and symbol.
SQL_SA_PASSWORD=<strong-password>
SQL_DATABASE=AmlDb
# Developer edition is free for test only; for production licence use Standard / Enterprise (MSSQL_PID).
MSSQL_PID=Developer

# Cryptography: 32 random bytes, base64. Losing SECURITY_ENCRYPTION_KEY makes encrypted fields unreadable — back it up.
SECURITY_ENCRYPTION_KEY=<base64-32-bytes>
SECURITY_SEARCH_TOKEN_KEY=<base64-32-bytes>
SECURITY_INTEGRITY_KEY=<base64-32-bytes>
SECURITY_ENCRYPTION_KEY_ID=k1

# Token signing key (at least 32 characters).
AUTH_SIGNING_KEY=<random-at-least-32-chars>
# Enterprise identity provider (leave empty to use the built-in development login).
AUTH_AUTHORITY=

# Built-in login for testing: seeds users admin, manager, officer, senior, mlro, investigator, auditor, ops with this password.
DEVAUTH_ENABLED=true
DEVAUTH_SEED_PASSWORD=<test-users-password>
# Secret of the integration clients (jo-demo-core, jo-demo-wallet, jo-demo-cards) used by source systems.
INTEGRATION_CLIENT_SECRET=<integration-client-secret>

# Synthetic demo customers, transactions, alerts and cases (true only for demos).
SEED_DEMO_DATA=true
# HTTP-only test deployment: keep false. Set true when nginx/a load balancer serves HTTPS.
HTTPS_REDIRECT=false
# Interactive API documentation at /swagger.
SWAGGER_ENABLED=true
