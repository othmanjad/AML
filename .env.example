# AML Platform — environment configuration example (NO real secrets; replace every <...> value).
# ASP.NET Core reads nested keys with "__" (double underscore). Load with your secret manager in non-dev environments.

ASPNETCORE_ENVIRONMENT=Development            # Development | Testing | Staging | Production
ASPNETCORE_URLS=http://localhost:5080

# SQL Server (2019+). Use a least-privilege login in production (no ALTER/DROP on AuditLogs).
ConnectionStrings__Aml=Server=localhost,1433;Database=AML_Dev;User Id=<sql-user>;Password=<sql-password>;TrustServerCertificate=true

# Cryptography: 32-byte random keys, base64-encoded (e.g. `openssl rand -base64 32`). Store in a KMS/secret manager.
Security__EncryptionKey=<base64-32-bytes>      # AES-GCM for sensitive fields / provider responses
Security__SearchTokenKey=<base64-32-bytes>     # HMAC search tokens for identifiers, phones, e-mails
Security__IntegrityKey=<base64-32-bytes>       # HMAC chain for audit-log integrity
Security__EncryptionKeyId=k1                   # key identifier stored with ciphertext (rotation)

# Authentication. Production: set Auth__Authority to the enterprise OIDC issuer and keep DevAuth disabled.
Auth__Authority=
Auth__Audience=aml-api
Auth__Issuer=aml-dev
Auth__SigningKey=<at-least-32-random-characters>   # development-only local token issuer
DevAuth__Enabled=true                          # NEVER true outside local development
DevAuth__SeedPassword=<dev-password-for-seeded-users>
Integrations__SeedClientSecret=<dev-client-secret-for-CORE/WALLET/CARDS>

# Behaviour
Database__MigrateOnStartup=true                # apply EF migrations + reference seed on API start (dev/test)
Seed__DemoData=true                            # fictitious demo customer/transactions/alert/case/draft STR
Jobs__RunInApi=true                            # dev convenience; production runs jobs in AML.Worker
Jobs__RuleIntervalMinutes=60
Integrations__CoreAdapter=Mock                 # only the mock/sandbox adapter exists (see docs/KNOWN-GAPS.md)
Storage__Root=/var/aml/files                   # evidence/export storage OUTSIDE the web root
Logging__FilePath=                             # optional JSON log file (masked)
Cors__Origins=http://localhost:5173

# Frontend (Vite dev server proxy target)
AML_API_URL=http://localhost:5080
